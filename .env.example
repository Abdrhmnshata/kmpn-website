# Supabase — from the project's API settings.
# The site builds and runs without these; success stories fall back to the
# seed list in lib/stories.ts and the contact form reports that it is off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Not used by the current code; keep it out of the client.
SUPABASE_SERVICE_ROLE_KEY=

# Notion — client portal (/portal). Server-only; on Vercel as a Sensitive
# variable. Token of a separate integration ("KMPN Portal": Read + Insert
# content) connected only to the "Client Portal - بوابة العملاء" page and the
# "KC - Master Customers" database. Without it the portal still works for
# sign-up and login, and shows empty projects / invoices / tickets.
NOTION_PORTAL_TOKEN=

# Notion — portfolio sync (`npm run sync:portfolio`, run by hand; local only).
# An internal integration token connected to the "Kampaign Portfolio" page
# in Notion. Updates to أعمالنا are manual: the build never uses this, so do
# not add it to Vercel.
NOTION_TOKEN=

# Client performance reports (/report/<slug>). Server-only.
# Service account "Sheets Reader" (Google Cloud project kmpn-reports), Viewer on
# the performance sheet only. On Vercel paste the whole key file as one value
# in GOOGLE_SERVICE_ACCOUNT_JSON; locally GOOGLE_SERVICE_ACCOUNT_FILE can point
# to the key file instead. Without either, reports say they are unavailable.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
# One password per client, at least 8 characters: REPORT_PASSWORD_<SLUG>.
REPORT_PASSWORD_OTTROJA=
