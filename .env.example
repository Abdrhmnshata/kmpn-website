# Supabase — from the project's API settings.
# The site builds and runs without these; success stories fall back to the
# seed list in lib/stories.ts and the contact form reports that it is off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Not used by the current code; keep it out of the client.
SUPABASE_SERVICE_ROLE_KEY=
